<!DOCTYPE html>
<html lang="{{language}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#ifCond language '==' 'en'}}AI Tools{{else}}Outils IA{{/ifCond}} - TwiixAI</title>
    <link rel="icon" href="/img/logo.ico" type="image/x-icon">
    <link rel="stylesheet" href="/css/normalize.css" />
    <link rel="stylesheet" href="/css/variables.css" />
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/sidebar.css"> 
    <link rel="stylesheet" href="/css/ai-tools.css">
    <script>const translations = `{{{json translations}}}`;</script>
</head>
<body>
    {{> sidebar translations=translations language=language}} 

    <div id="main-content">
        {{> header translations=translations}}
        
        <header>
            <h1>{{#ifCond language '==' 'en'}}Explore Our AI Tools{{else}}Découvrez nos outils IA{{/ifCond}}</h1>
            <p>{{#ifCond language '==' 'en'}}Powerful AI-powered tools to enhance your creative projects{{else}}Des outils puissants alimentés par l'IA pour améliorer vos projets créatifs{{/ifCond}}</p>
        </header>
        
        <section class="tools-section">
            <div class="tools-grid">
                <!-- Video AI Tools -->
                
                <!-- 1. Video Face Swap -->
                <div class="tool-card">
                    <div class="tool-card-image">
                        <img src="/img/examples/main-1.jpg" alt="Video Face Swap - Replace faces in videos">
                        <a href="/?mode=video" class="tool-action-btn">
                            <i class="bi bi-arrow-right"></i> Launch Tool
                        </a>
                    </div>
                    <div class="tool-card-content">
                        <h3 class="tool-card-title">{{#ifCond language '==' 'en'}}Video Face Swap{{else}}Échange de Visage Vidéo{{/ifCond}}</h3>
                        <p class="tool-card-description">{{#ifCond language '==' 'en'}}Replace faces in videos with professional results. Free mode for image-to-image, premium for video-to-video.{{else}}Remplacez les visages dans les vidéos avec des résultats professionnels. Mode gratuit pour image-vers-image, premium pour vidéo-vers-vidéo.{{/ifCond}}</p>
                        <div class="feature-badges">
                            <span class="feature-badge free">{{#ifCond language '==' 'en'}}Free{{else}}Gratuit{{/ifCond}}</span>
                            <span class="feature-badge premium">{{#ifCond language '==' 'en'}}Premium{{else}}Premium{{/ifCond}}</span>
                        </div>
                    </div>
                </div>

                <!-- 2. Image to Video -->
                <div class="tool-card">
                    <div class="tool-card-image">
                        <img src="/img/examples/main-2.jpg" alt="Image to Video - Generate videos from images">
                        <a href="/image-to-video" class="tool-action-btn">
                            <i class="bi bi-arrow-right"></i> Launch Tool
                        </a>
                    </div>
                    <div class="tool-card-content">
                        <h3 class="tool-card-title">{{#ifCond language '==' 'en'}}Image to Video{{else}}Image vers Vidéo{{/ifCond}}</h3>
                        <p class="tool-card-description">{{#ifCond language '==' 'en'}}Generate dynamic videos from static images using AI. Multiple models and customization options available.{{else}}Générez des vidéos dynamiques à partir d'images statiques en utilisant l'IA. Plusieurs modèles et options de personnalisation disponibles.{{/ifCond}}</p>
                        <div class="feature-badges">
                            <span class="feature-badge premium">{{#ifCond language '==' 'en'}}Premium{{else}}Premium{{/ifCond}}</span>
                        </div>
                    </div>
                </div>

                <!-- 3. Image Face Swap -->
                <div class="tool-card">
                    <div class="tool-card-image">
                        <img src="/img/examples/swap-1.jpg" alt="Image Face Swap - Replace faces in images">
                        <a href="/?mode=image" class="tool-action-btn">
                            <i class="bi bi-arrow-right"></i> Launch Tool
                        </a>
                    </div>
                    <div class="tool-card-content">
                        <h3 class="tool-card-title">{{#ifCond language '==' 'en'}}Image Face Swap{{else}}Échange de Visage Image{{/ifCond}}</h3>
                        <p class="tool-card-description">{{#ifCond language '==' 'en'}}Swap faces in static images with ease. Perfect for fun photos and creative projects.{{else}}Échangez les visages dans les images statiques facilement. Parfait pour les photos amusantes et les projets créatifs.{{/ifCond}}</p>
                        <div class="feature-badges">
                            <span class="feature-badge free">{{#ifCond language '==' 'en'}}Free{{else}}Gratuit{{/ifCond}}</span>
                        </div>
                    </div>
                </div>

                <!-- 4. My Creations -->
                <div class="tool-card">
                    <div class="tool-card-image">
                        <img src="/img/examples/swap-2.jpg" alt="My Creations - View your processing history">
                        <a href="/history" class="tool-action-btn">
                            <i class="bi bi-arrow-right"></i> View
                        </a>
                    </div>
                    <div class="tool-card-content">
                        <h3 class="tool-card-title">{{#ifCond language '==' 'en'}}My Creations{{else}}Mes Créations{{/ifCond}}</h3>
                        <p class="tool-card-description">{{#ifCond language '==' 'en'}}Access your processing history and download generated content. Track all your AI-powered creations in one place.{{else}}Accédez à votre historique de traitement et téléchargez le contenu généré. Suivez toutes vos créations alimentées par l'IA au même endroit.{{/ifCond}}</p>
                        <div class="feature-badges">
                            <span class="feature-badge free">{{#ifCond language '==' 'en'}}Free{{else}}Gratuit{{/ifCond}}</span>
                        </div>
                    </div>
                </div>

                <!-- 5. AI Tools Showcase -->
                <div class="tool-card">
                    <div class="tool-card-image">
                        <img src="/img/examples/swap-3.jpg" alt="AI Tools Showcase - Browse all tools">
                        <a href="/ai-tools" class="tool-action-btn">
                            <i class="bi bi-arrow-right"></i> Explore
                        </a>
                    </div>
                    <div class="tool-card-content">
                        <h3 class="tool-card-title">{{#ifCond language '==' 'en'}}AI Tools Showcase{{else}}Vitrine des Outils IA{{/ifCond}}</h3>
                        <p class="tool-card-description">{{#ifCond language '==' 'en'}}Discover all available AI tools and features. Browse, compare, and launch tools directly from the showcase.{{else}}Découvrez tous les outils et fonctionnalités d'IA disponibles. Parcourez, comparez et lancez les outils directement depuis la vitrine.{{/ifCond}}</p>
                        <div class="feature-badges">
                            <span class="feature-badge free">{{#ifCond language '==' 'en'}}Free{{else}}Gratuit{{/ifCond}}</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    {{> footer translations=translations}}
    
    <script src="/sidebar.js"></script>
</body>
</html>
