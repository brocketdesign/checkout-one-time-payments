<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/img/logo.ico" type="image/x-icon">
    <title>{{ translations.title }}</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VYS6LYR9KZ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-VYS6LYR9KZ');
    </script>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="/css/normalize.css" />
    <link rel="stylesheet" href="/css/variables.css" />
        
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/dropzone@5.9.3/dist/min/dropzone.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js@9.0.1/public/assets/styles/choices.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/nouislider@15.6.1/dist/nouislider.min.css">


    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/image-to-video.css" />
    <script src="/js/jquery-3.6.0.min.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
  </head>
  

<body>
    {{> sidebar}}
    <div id="main-content">
        {{> header}}
        
        <div class="i2v-container">
        <div class="i2v-grid">
                <!-- Left Column: Controls -->
                <div>
                    <div class="i2v-card">
                        <div class="i2v-card-header">
                            <h3>{{t "image_to_video_title" "Image to Video"}}</h3>
                        </div>
                        <div class="i2v-card-body">
                            <!-- Model Selection -->
                            <div class="section">
                                <div class="form-group">
                                    <label class="form-label">{{t "select_model" "Select Model"}}</label>
                                    <select id="i2vModelSelect" class="form-select">
                                        <option value="kling-v1.6-i2v" selected>{{t "kling_model" "Kling v1.6 (Recommended)"}}</option>
                                        <option value="wan-i2v">{{t "wanx_model" "WanX I2V"}}</option>
                                    </select>
                                    <p class="form-help-text">{{t "model_select_help_i2v" "Choose a model for video generation."}}</p>
                                </div>
                            </div>

                            <!-- Image Upload -->
                            <div class="section">
                                <label class="form-label">{{t "upload_image_i2v" "Upload Image"}}</label>
                                <div id="i2vImageDropZone" class="upload-zone">
                                    <div id="i2vImageDetails" class="upload-zone-content">
                                        <div class="upload-icon">
                                            <i class="bi bi-cloud-arrow-up"></i>
                                        </div>
                                        <p class="upload-text">{{t "drag_drop_image_i2v" "Drag & drop an image here, or click to select"}}</p>
                                        <button id="i2vImageUploadBtn" class="btn btn-secondary btn-sm upload-button">{{t "select_image_btn" "Select Image"}}</button>
                                        <p class="upload-hint">{{t "i2v_image_requirements" "Upload JPG/PNG/WEBP images up to 10MB, with a minimum width/height of 300px."}}</p>
                                    </div>
                                    <input type="file" id="i2vImageInput" accept="image/jpeg,image/png,image/webp" class="d-none">
                                    <div id="i2vImagePreviewContainer" class="preview-container" style="display: none;">
                                        <img id="i2vImagePreview" src="#" alt="{{t 'image_preview_alt' 'Image preview'}}"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Prompt -->
                            <div class="section">
                                <div class="form-group">
                                    <label class="form-label">{{t "prompt_optional" "Prompt (Optional)"}}</label>
                                    <textarea id="i2vPrompt" class="form-control" rows="3" maxlength="2000" placeholder="{{t 'i2v_prompt_placeholder' 'Describe what you want to create with this image...'}}"></textarea>
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 6px;">
                                        <p class="form-help-text" style="margin: 0;">{{t "prompt_help_i2v" "Describe the desired motion, scene, or story for your video."}}</p>
                                        <span class="small" style="color: var(--color-text-secondary);"><span id="i2vPromptCharCount">0</span>/2000</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Advanced Options -->
                            <div class="accordion">
                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#advancedOptionsCollapse" aria-expanded="false" aria-controls="advancedOptionsCollapse">
                                            {{t "advanced_options" "Advanced Options"}}
                                        </button>
                                    </h2>
                                    <div id="advancedOptionsCollapse" class="accordion-collapse collapse" aria-labelledby="advancedOptionsHeading" data-bs-parent="#advancedOptionsAccordion">
                                        <div class="accordion-body">
                                            <!-- Mode Selection -->
                                            <div class="form-group">
                                                <label class="form-label">{{t "mode" "Mode"}}</label>
                                                <select id="i2vMode" class="form-select">
                                                    <option value="Standard" selected>{{t "standard_mode" "Standard (720p, faster)"}}</option>
                                                    <option value="Professional">{{t "professional_mode" "Professional (1080p, higher quality)"}}</option>
                                                </select>
                                                <p class="form-help-text">{{t "mode_help_i2v" "Standard: faster 720p. Professional: higher quality 1080p."}}</p>
                                            </div>

                                            <!-- Motion Intensity -->
                                            <div class="form-group">
                                                <label class="form-label">{{t "motion_intensity" "Motion Intensity"}}</label>
                                                <div id="i2vMotionIntensitySlider"></div>
                                                <div style="display: flex; justify-content: space-between; margin-top: 8px;">
                                                    <span class="small text-muted">Subtle</span>
                                                    <span class="small" style="font-weight: 600; color: var(--color-accent-purple);"><span id="i2vMotionIntensityValue">127</span></span>
                                                    <span class="small text-muted">Dynamic</span>
                                                </div>
                                            </div>

                                            <!-- Negative Prompt -->
                                            <div class="form-group">
                                                <label class="form-label">{{t "negative_prompt" "Negative Prompt (Optional)"}}</label>
                                                <textarea id="i2vNegativePrompt" class="form-control" rows="2" maxlength="2000" placeholder="{{t 'i2v_negative_prompt_placeholder' 'Specify what to avoid in the video...'}}"></textarea>
                                                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 6px;">
                                                    <p class="form-help-text" style="margin: 0;">{{t "negative_prompt_help_i2v" "Describe elements to avoid (e.g. 'no text, no watermark')."}}</p>
                                                    <span class="small" style="color: var(--color-text-secondary);"><span id="i2vNegativePromptCharCount">0</span>/2000</span>
                                                </div>
                                            </div>

                                            <!-- Kling Model Options -->
                                            <div id="i2vKlingOptions">
                                                <div class="form-group">
                                                    <label class="form-label">{{t "guidance_scale" "Guidance Scale"}}</label>
                                                    <div id="i2vGuidanceScaleSlider"></div>
                                                    <div style="display: flex; justify-content: space-between; margin-top: 8px;">
                                                        <span class="small text-muted">Creative</span>
                                                        <span class="small" style="font-weight: 600; color: var(--color-accent-purple);"><span id="i2vGuidanceScaleValue">0.5</span></span>
                                                        <span class="small text-muted">Precise</span>
                                                    </div>
                                                </div>

                                                <div id="i2vEndImageContainer" class="d-none">
                                                    <div class="form-switch">
                                                        <input class="form-check-input" type="checkbox" role="switch" id="i2vAddEndFrame">
                                                        <label class="form-check-label" for="i2vAddEndFrame">
                                                            {{t "add_end_frame" "Add End Frame"}}
                                                        </label>
                                                    </div>
                                                    <p class="form-help-text">{{t "end_image_help_i2v" "Specify a target image for the last frame (Professional mode only)."}}</p>

                                                    <div id="endFrameSection" class="d-none" style="margin-top: 12px;">
                                                        <label class="form-label" style="margin-bottom: 10px;">{{t "end_image" "End Frame Image"}}</label>
                                                        <div id="i2vEndImageDropZone" class="upload-zone" style="min-height: 150px;">
                                                            <div class="upload-zone-content">
                                                                <i class="bi bi-file-earmark-image upload-icon"></i>
                                                                <p class="upload-text small" style="margin: 0;">{{t "drag_drop_end_image" "Drag & drop end frame image"}}</p>
                                                                <button id="i2vEndImageUploadBtn" class="btn btn-secondary btn-sm" style="margin-top: 8px;">{{t "select_end_image_btn" "Select"}}</button>
                                                            </div>
                                                            <input type="file" id="i2vEndImageInput" accept="image/jpeg,image/png,image/webp" class="d-none">
                                                            <div id="i2vEndImagePreviewContainer" class="preview-container" style="display: none;">
                                                                <img id="i2vEndImagePreview" src="#" alt="End frame preview"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Wan Model Options -->
                                            <div id="i2vWanOptions" class="d-none">
                                                <div class="form-group">
                                                    <label class="form-label">{{t "resolution" "Resolution"}}</label>
                                                    <select id="i2vResolution" class="form-select">
                                                        <option value="720p" selected>{{t "720p" "720p (1280x720)"}}</option>
                                                        <option value="480p">{{t "480p" "480p (832x480)"}}</option>
                                                    </select>
                                                    <p class="form-help-text">{{t "resolution_help_i2v" "Choose output video resolution."}}</p>
                                                </div>

                                                <div class="form-group">
                                                    <label class="form-label">{{t "seed" "Seed (-1 for random)"}}</label>
                                                    <input type="number" id="i2vSeed" class="form-control" min="-1" max="9999999999" value="-1">
                                                    <p class="form-help-text">{{t "seed_help_i2v" "Set a random seed for reproducibility."}}</p>
                                                </div>

                                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                                                    <div class="form-group">
                                                        <label class="form-label">{{t "steps" "Steps"}}</label>
                                                        <div id="i2vStepsSlider"></div>
                                                        <div style="display: flex; justify-content: space-between; margin-top: 8px;">
                                                            <span class="small text-muted">Fast</span>
                                                            <span class="small" style="font-weight: 600; color: var(--color-accent-purple);"><span id="i2vStepsValue">30</span></span>
                                                            <span class="small text-muted">Quality</span>
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="form-label">{{t "wan_guidance_scale" "Guidance Scale"}}</label>
                                                        <div id="i2vWanGuidanceScaleSlider"></div>
                                                        <div style="display: flex; justify-content: space-between; margin-top: 8px;">
                                                            <span class="small text-muted">Creative</span>
                                                            <span class="small" style="font-weight: 600; color: var(--color-accent-purple);"><span id="i2vWanGuidanceScaleValue">5.0</span></span>
                                                            <span class="small text-muted">Precise</span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    <label class="form-label">{{t "flow_shift" "Flow Shift (Motion Speed)"}}</label>
                                                    <div id="i2vFlowShiftSlider"></div>
                                                    <div style="display: flex; justify-content: space-between; margin-top: 8px;">
                                                        <span class="small text-muted">Slow</span>
                                                        <span class="small" style="font-weight: 600; color: var(--color-accent-purple);"><span id="i2vFlowShiftValue">5.0</span></span>
                                                        <span class="small text-muted">Fast</span>
                                                    </div>
                                                </div>

                                                <div class="form-switch">
                                                    <input class="form-check-input" type="checkbox" role="switch" id="i2vFastMode">
                                                    <label class="form-check-label" for="i2vFastMode">{{t "fast_mode" "Fast Mode"}}</label>
                                                </div>
                                                <p class="form-help-text">{{t "fast_mode_help_i2v" "Faster but lower quality results."}}</p>

                                                <div class="form-switch">
                                                    <input class="form-check-input" type="checkbox" role="switch" id="i2vSafetyChecker" checked>
                                                    <label class="form-check-label" for="i2vSafetyChecker">{{t "safety_checker" "Enable Safety Filter"}}</label>
                                                </div>
                                                <p class="form-help-text">{{t "safety_checker_help_i2v" "Filter out inappropriate content."}}</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Payment Section -->
                            <div class="payment-card">
                                <div class="payment-info">
                                    <div class="payment-label">{{t "payment_info" "Payment"}}</div>
                                    <div class="payment-amount">$2.00</div>
                                    <p class="form-help-text" style="margin-top: 4px;">{{t "i2v_payment_description" "Per video generation"}}</p>
                                </div>
                                <div id="i2vPaymentStatus" class="payment-status warning">
                                    <i class="bi bi-info-circle-fill"></i>
                                    <span>{{t "payment_required" "Payment required"}}</span>
                                </div>
                                <input class="form-check-input" type="checkbox" role="switch" id="i2vSkipPayment" style="display: none;">
                            </div>

                            <script>
                                // Only show skip payment checkbox on localhost
                                if (window.location.hostname === 'localhost' || window.location.hostname.includes('192.168.')) {
                                    document.getElementById('i2vSkipPayment').style.display = 'block';
                                    document.getElementById('i2vSkipPayment').checked = true;
                                    document.getElementById('i2vPaymentStatus').classList.remove('warning');
                                    document.getElementById('i2vPaymentStatus').innerHTML = '<i class="bi bi-check-circle-fill"></i><span>{{t "payment_skipped_local" "Payment skipped (local)"}}</span>';
                                }
                            </script>
                        </div>
                        <div class="i2v-card-footer">
                            <button id="generateImageToVideoButton" class="btn btn-primary btn-lg">
                                <i class="bi bi-magic"></i>{{t "create_video_btn" "Create Video"}}
                            </button>
                            <div id="i2vStatus" style="margin-top: 12px;"></div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Output -->
                <div>
                    <div class="i2v-card">
                        <div class="i2v-card-header">
                            <h3>{{t "output_video_title" "Output Video"}}</h3>
                        </div>
                        <div class="i2v-card-body">
                            <!-- Generated Video -->
                            <div id="i2vResultSection" style="display: none;">
                                <video id="i2vGeneratedVideo" controls style="width: 100%; border-radius: 10px;"></video>
                                <a id="downloadVideoLink" href="#" class="btn btn-primary" download="generated_video.mp4" style="display: none; width: 100%;">
                                    <i class="bi bi-download"></i>{{t "download_video_btn" "Download Video"}}
                                </a>
                            </div>

                            <!-- Placeholder -->
                            <div id="i2vSampleVideoPlaceholder" class="output-placeholder">
                                <div class="output-icon">
                                    <i class="bi bi-film"></i>
                                </div>
                                <p class="output-text">{{t "video_placeholder_text" "Your generated video will appear here"}}</p>
                            </div>

                            <!-- Sample Gallery -->
                            <div>
                                <label class="form-label" style="margin-bottom: 12px;">{{t "sample_gallery_title" "Sample Gallery"}}</label>
                                <div class="gallery" id="i2vSampleGallery">
                                    <!-- Sample gallery items will be injected here by JS -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {{> footer}}
        </div>
    </div>
</body>

<script src="https://cdn.jsdelivr.net/npm/dropzone@5.9.3/dist/min/dropzone.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/choices.js@9.0.1/public/assets/scripts/choices.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/nouislider@15.6.1/dist/nouislider.min.js"></script>
<script src="/image-to-video.js"></script>
