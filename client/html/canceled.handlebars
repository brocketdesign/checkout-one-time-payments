<!DOCTYPE html>
<html lang="{{language}}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/img/logo.ico" type="image/x-icon">
    <title>{{ translations.payment_canceled }}</title>

    <link rel="icon" href="favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="/css/normalize.css" />
    <link rel="stylesheet" href="/css/variables.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/bootstrap-icons.css" />
    <script src="/js/jquery-3.6.0.min.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script>const translations = `{{{json translations}}}`;</script>
    <style>
      .error-alert {
        padding: var(--space-2xl);
        border-radius: var(--radius-lg);
        background-color: rgba(239, 68, 68, 0.1);
        border-left: 4px solid var(--color-error);
        margin-bottom: var(--space-2xl);
      }
      
      .error-alert h1 {
        color: var(--color-error);
        font-size: var(--font-size-3xl);
        font-weight: 700;
        margin-bottom: var(--space-lg);
      }
      
      .error-alert p {
        color: var(--color-text-secondary);
        font-size: var(--font-size-base);
        line-height: var(--line-height-relaxed);
        margin-bottom: var(--space-lg);
      }
      
      .action-buttons {
        display: flex;
        gap: var(--space-md);
        flex-wrap: wrap;
      }
      
      .action-buttons .btn {
        border-radius: var(--radius-md);
        padding: var(--space-md) var(--space-lg);
        font-weight: 500;
        transition: all var(--transition-base);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }
      
      .action-buttons .btn-primary {
        background: var(--color-accent-gradient);
        border: none;
        color: var(--color-text-primary);
      }
      
      .action-buttons .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 20px rgba(168, 85, 247, 0.3);
        color: var(--color-text-primary);
      }
      
      .action-buttons .btn-secondary {
        background-color: var(--color-bg-tertiary);
        border: 1px solid var(--color-border);
        color: var(--color-text-primary);
      }
      
      .action-buttons .btn-secondary:hover {
        background-color: var(--color-bg-secondary);
        color: var(--color-text-primary);
      }
      
      .error-icon {
        font-size: 3rem;
        color: var(--color-error);
        margin-bottom: var(--space-lg);
      }
    </style>
  </head>

  <body style="display: flex; flex-direction: column; min-height: 100vh; margin: 0;">
    {{> sidebar}}
    <div id="main-content" style="flex: 1 0 auto; display: flex; flex-direction: column; margin-left: 240px;">
      {{> header translations=translations}}
      <div style="width: 100%; height: 60px;"></div>
      <div class="container-fluid mt-3">
        <section class="main-container">
          <div class="error-alert">
            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
              <i class="bi bi-exclamation-circle error-icon"></i>
              <h1>{{ translations.payment_canceled }}</h1>
              <p>{{ translations.payment_canceled_message }}</p>
            </div>
            
            <div class="action-buttons" style="justify-content: center;">
              <a href="/" class="btn btn-primary">
                <i class="bi bi-house-fill me-2"></i>{{ translations.return_to_upload }}
              </a>
              <a href="{{#ifCond language '==' 'en'}}/history{{else}}/{{language}}/history{{/ifCond}}" class="btn btn-secondary">
                <i class="bi bi-clock-history me-2"></i>{{ translations.history_title }}
              </a>
            </div>
          </div>
        </section>
        {{> footer translations=translations}}
      </div>
    </div>
  </body>
</html>
