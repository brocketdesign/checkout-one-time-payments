<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/img/logo.ico" type="image/x-icon">
    <title>{{ translations.title }}</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VYS6LYR9KZ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-VYS6LYR9KZ');
    </script>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="/css/normalize.css" />
    <link rel="stylesheet" href="/css/variables.css" />
        
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/dropzone@5.9.3/dist/min/dropzone.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js@9.0.1/public/assets/styles/choices.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/nouislider@15.6.1/dist/nouislider.min.css">


    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/text-to-video.css" />
    <script src="/js/jquery-3.6.0.min.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
  </head>
  

<body>
    {{> sidebar}}
    <div id="main-content">
            {{> header}}
        <section id="top" class="app-hero-section">
          <div class=" mb-3">
            <div class="hero-content">
              <h1 id="title" class="hero-title">{{t "text_to_video_hero_title" "Text to Video Generator"}}</h1>
              <p id="subtitle" class="hero-subtitle">{{t "text_to_video_subtitle" "Transform your text descriptions into stunning videos with AI technology."}}</p>
            </div>
          </div>
        </section>
        
        <div class="t2v-container pt-0">
        <div class="t2v-grid mt-0">
                <!-- Left Column: Controls -->
                <div>
                    <div class="t2v-card">
                        <div class="t2v-card-header">
                            <h3>{{t "text_to_video_title" "Text to Video"}}</h3>
                        </div>
                        <div class="t2v-card-body">
                            <!-- Model Selection -->
                            <div class="section">
                                <div class="form-group">
                                    <label class="form-label">{{t "select_model" "Select Model"}}</label>
                                    <select id="t2vModelSelect" class="form-select">
                                        <option value="kling-v1.6-t2v" selected>{{t "kling_t2v_model" "Kling v1.6 (Text to Video)"}}</option>
                                    </select>
                                    <p class="form-help-text">{{t "model_select_help_t2v" "Choose a model for video generation."}}</p>
                                </div>
                            </div>

                            <!-- Prompt -->
                            <div class="section">
                                <div class="form-group">
                                    <label class="form-label">{{t "prompt_required" "Prompt (Required)"}}</label>
                                    <textarea id="t2vPrompt" class="form-control" rows="4" maxlength="2000" placeholder="{{t 't2v_prompt_placeholder' 'Describe the video you want to create...'}}"></textarea>
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 6px;">
                                        <p class="form-help-text" style="margin: 0;">{{t "prompt_help_t2v" "Describe the scene, action, and style for your video."}}</p>
                                        <span class="small" style="color: var(--color-text-secondary);"><span id="t2vPromptCharCount">0</span>/2000</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Advanced Options -->
                            <div class="accordion">
                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#advancedOptionsCollapse" aria-expanded="false" aria-controls="advancedOptionsCollapse">
                                            {{t "advanced_options" "Advanced Options"}}
                                        </button>
                                    </h2>
                                    <div id="advancedOptionsCollapse" class="accordion-collapse collapse" aria-labelledby="advancedOptionsHeading" data-bs-parent="#advancedOptionsAccordion">
                                        <div class="accordion-body">
                                            <!-- Mode Selection -->
                                            <div class="form-group">
                                                <label class="form-label">{{t "mode" "Mode"}}</label>
                                                <select id="t2vMode" class="form-select">
                                                    <option value="Standard" selected>{{t "standard_mode" "Standard (720p, faster)"}}</option>
                                                    <option value="Professional">{{t "professional_mode" "Professional (1080p, higher quality)"}}</option>
                                                </select>
                                                <p class="form-help-text">{{t "mode_help_t2v" "Standard: faster 720p. Professional: higher quality 1080p."}}</p>
                                            </div>

                                            <!-- Duration -->
                                            <div class="form-group">
                                                <label class="form-label">{{t "duration" "Duration"}}</label>
                                                <select id="t2vDuration" class="form-select">
                                                    <option value="5" selected>5 seconds</option>
                                                    <option value="10">10 seconds</option>
                                                </select>
                                                <p class="form-help-text">{{t "duration_help_t2v" "Choose the length of the generated video."}}</p>
                                            </div>

                                            <!-- Negative Prompt -->
                                            <div class="form-group">
                                                <label class="form-label">{{t "negative_prompt" "Negative Prompt (Optional)"}}</label>
                                                <textarea id="t2vNegativePrompt" class="form-control" rows="2" maxlength="2000" placeholder="{{t 't2v_negative_prompt_placeholder' 'Specify what to avoid in the video...'}}"></textarea>
                                                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 6px;">
                                                    <p class="form-help-text" style="margin: 0;">{{t "negative_prompt_help_t2v" "Describe elements to avoid (e.g. 'no text, no watermark')."}}</p>
                                                    <span class="small" style="color: var(--color-text-secondary);"><span id="t2vNegativePromptCharCount">0</span>/2000</span>
                                                </div>
                                            </div>

                                            <!-- Guidance Scale -->
                                            <div class="form-group">
                                                <label class="form-label">{{t "guidance_scale" "Guidance Scale"}}</label>
                                                <div id="t2vGuidanceScaleSlider"></div>
                                                <div style="display: flex; justify-content: space-between; margin-top: 8px;">
                                                    <span class="small text-muted">Creative</span>
                                                    <span class="small" style="font-weight: 600; color: var(--color-accent-purple);"><span id="t2vGuidanceScaleValue">0.5</span></span>
                                                    <span class="small text-muted">Precise</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Payment Section -->
                            <div class="payment-card">
                                <div class="payment-info">
                                    <div class="payment-label">{{t "payment_info" "Payment"}}</div>
                                    <div class="payment-amount">$2.00</div>
                                    <p class="form-help-text" style="margin-top: 4px;">{{t "t2v_payment_description" "Per video generation"}}</p>
                                </div>
                                <div id="t2vPaymentStatus" class="payment-status warning">
                                    <i class="bi bi-info-circle-fill"></i>
                                    <span>{{t "payment_required" "Payment required"}}</span>
                                </div>
                                <div class="form-check form-switch" id="t2vSkipPaymentContainer" style="display: none;">
                                    <input class="form-check-input" type="checkbox" role="switch" id="t2vSkipPayment">
                                    <label class="form-check-label" for="t2vSkipPayment">{{t "skip_payment_local" "Skip Payment (Local Testing)"}}</label>
                                </div>
                            </div>
                        </div>
                        <div class="t2v-card-footer">
                            <button id="generateTextToVideoButton" class="btn btn-primary btn-lg">
                                <i class="bi bi-magic"></i>{{t "create_video_btn" "Create Video"}}
                            </button>
                            <div id="t2vStatus" style="margin-top: 12px;"></div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Output -->
                <div>
                    <div class="t2v-card">
                        <div class="t2v-card-header">
                            <h3>{{t "output_video_title" "Output Video"}}</h3>
                        </div>
                        <div class="t2v-card-body">
                            <!-- Generated Video -->
                            <div id="t2vResultSection" style="display: none;">
                                <video id="t2vGeneratedVideo" controls style="width: 100%; border-radius: 10px;"></video>
                                <a id="t2vDownloadVideoLink" href="#" class="btn btn-primary" download="generated_video.mp4" style="display: none; width: 100%;">
                                    <i class="bi bi-download"></i>{{t "download_video_btn" "Download Video"}}
                                </a>
                            </div>

                            <!-- Placeholder -->
                            <div id="t2vSampleVideoPlaceholder" class="output-placeholder">
                                <div class="output-icon">
                                    <i class="bi bi-film"></i>
                                </div>
                                <p class="output-text">{{t "video_placeholder_text" "Your generated video will appear here"}}</p>
                            </div>

                            <!-- Sample Gallery -->
                            <div>
                                <label class="form-label" style="margin-bottom: 12px;">{{t "prompt_examples_title" "Prompt Examples"}}</label>
                                <div id="t2vSampleGallery">
                                    <!-- Prompt examples will be injected here by JS -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{> footer}}
</body>

<script src="https://cdn.jsdelivr.net/npm/dropzone@5.9.3/dist/min/dropzone.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/choices.js@9.0.1/public/assets/scripts/choices.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/nouislider@15.6.1/dist/nouislider.min.js"></script>
<script src="/text-to-video.js"></script>
</html>