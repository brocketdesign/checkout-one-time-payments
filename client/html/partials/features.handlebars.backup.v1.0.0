<div class="features">
  <!-- How to face swap -->
  <section id="how-to-faceswap" class="py-5" style="background-color: var(--color-bg-primary);">
    <div class="">
      <h2 class="display-5 fw-bold text-center mb-5" style="color: var(--color-text-primary);">{{ translations.howToFaceSwap.heading }}</h2>
      <div class="row">
        <div class="col-lg-4 mb-4">
          <div class="card shadow-sm h-100" style="background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
            <div class="card-body text-center">
              <div class="rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 60px; height: 60px; background: linear-gradient(135deg, var(--color-accent-purple), var(--color-accent-pink));">
                <span style="color: var(--color-text-primary); font-weight: bold; font-size: 1.5rem;">01</span>
              </div>
              <h3 class="h5 card-title" style="color: var(--color-text-primary); font-weight: 600;">{{ translations.howToFaceSwap.step1.title }}</h3>
              <p class="card-text" style="color: var(--color-text-secondary);">{{ translations.howToFaceSwap.step1.description }}</p>
              <p class="card-text" style="color: var(--color-text-secondary);">{{ translations.howToFaceSwap.step1.support }}</p>
              <p class="card-text" style="color: var(--color-text-muted);">{{ translations.howToFaceSwap.step1.tip }}</p>
            </div>
          </div>
        </div>

        <div class="col-lg-4 mb-4">
          <div class="card shadow-sm h-100" style="background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
            <div class="card-body text-center">
              <div class="rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 60px; height: 60px; background: linear-gradient(135deg, var(--color-accent-purple), var(--color-accent-pink));">
                <span style="color: var(--color-text-primary); font-weight: bold; font-size: 1.5rem;">02</span>
              </div>
              <h3 class="h5 card-title" style="color: var(--color-text-primary); font-weight: 600;">{{ translations.howToFaceSwap.step2.title }}</h3>
              <p class="card-text" style="color: var(--color-text-secondary);">{{ translations.howToFaceSwap.step2.description }}</p>
              <p class="card-text" style="color: var(--color-text-secondary);">{{ translations.howToFaceSwap.step2.select }}</p>
            </div>
          </div>
        </div>

        <div class="col-lg-4 mb-4">
          <div class="card shadow-sm h-100" style="background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
            <div class="card-body text-center">
              <div class="rounded-circle d-inline-flex justify-content-center align-items-center mb-3" style="width: 60px; height: 60px; background: linear-gradient(135deg, var(--color-accent-purple), var(--color-accent-pink));">
                <span style="color: var(--color-text-primary); font-weight: bold; font-size: 1.5rem;">03</span>
              </div>
              <h3 class="h5 card-title" style="color: var(--color-text-primary); font-weight: 600;">{{ translations.howToFaceSwap.step3.title }}</h3>
              <p class="card-text" style="color: var(--color-text-secondary);">{{ translations.howToFaceSwap.step3.description }}</p>
              <p class="card-text" style="color: var(--color-text-secondary);">{{ translations.howToFaceSwap.step3.wait }}</p>
              <p class="card-text" style="color: var(--color-text-secondary);">{{ translations.howToFaceSwap.step3.download }}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Hero Section -->
  <section id="hero" class="py-5 py-lg-6 " style="background-color: var(--color-bg-primary);">
    <div class="">
      <div class="row align-items-center g-4">
        <div class="col-lg-6">
          <img src="/img/demo-swap1.webp" alt="{{ translations.hero.imageAlt }}" class="img-fluid rounded shadow-sm" style="border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
        </div>
        <div class="col-lg-6">
          <h1 class="display-4 fw-bold mb-3" style="color: var(--color-text-primary);">{{ translations.hero.headline }}</h1>
          <p class="lead mb-4" style="color: var(--color-text-secondary);">{{ translations.hero.tagline }}</p>
          {{#if translations.hero.cta}}
            <a href="#top" class="btn btn-lg rounded-pill px-4 py-2 cta" style="background: var(--color-accent-gradient); color: var(--color-text-primary); border: none; font-weight: 500; transition: all var(--transition-base);" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 0 20px rgba(168, 85, 247, 0.3)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'">
              {{ translations.hero.cta }}
              <i class="bi bi-arrow-right-circle ms-2"></i>
            </a>
          {{/if}}
        </div>
      </div>
    </div>
  </section>

  <!-- Demo Section -->
  <section id="demo" class="py-5 py-lg-6" style="background-color: var(--color-bg-primary);">
    <div class="">
      <div class="row align-items-center g-4">
        <div class="col-lg-6 order-lg-2">
          <img src="/img/demo-swap2.webp" alt="{{ translations.demo.imageAlt }}" class="img-fluid rounded shadow-sm" style="border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
        </div>
        <div class="col-lg-6 order-lg-1">
          <div class="pe-lg-4">
            <h2 class="display-5 fw-bold mb-3" style="color: var(--color-text-primary);">{{ translations.demo.heading }}</h2>
            <p class="lead" style="color: var(--color-text-secondary);">{{ translations.demo.description }}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section id="how-it-works" class="py-5 py-lg-6 " style="background-color: var(--color-bg-primary);">
    <div class="">
      <div class="row align-items-center g-4">
        <div class="col-lg-6">
          <img src="/img/demo-swap3.gif" alt="{{ translations.howItWorks.heading }}" class="img-fluid rounded shadow-sm" style="border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
        </div>
        <div class="col-lg-6">
          <div class="ps-lg-4">
            <h2 class="display-5 fw-bold mb-3" style="color: var(--color-text-primary);">{{ translations.howItWorks.heading }}</h2>
            <p class="lead" style="color: var(--color-text-secondary);">{{ translations.howItWorks.step1.description }}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section id="benefits" class="py-5 py-lg-6" style="background-color: var(--color-bg-primary);">
    <div class="">
      <h2 class="display-5 fw-bold text-center mb-5" style="color: var(--color-text-primary);">{{ translations.benefits.heading }}</h2>
      <div class="row g-4 justify-content-center">
        <div class="col-md-6 col-lg-3" data-animate="animate__bounceIn">
          <div class="card h-100 border-0 shadow-sm" style="background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border) !important; border-radius: var(--radius-lg); transition: all var(--transition-base);" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 8px 20px rgba(0,0,0,0.4)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 8px rgba(0,0,0,0.2)'">
            <div class="card-body text-center p-4">
              <div style="color: var(--color-accent-purple); margin-bottom: var(--space-lg);">
                <i class="bi bi-camera-video-fill fs-1"></i>
              </div>
              <h3 class="h4 mb-3" style="color: var(--color-text-primary); font-weight: 600;">{{ translations.benefits.seamless.title }}</h3>
              <p class="card-text" style="color: var(--color-text-secondary);">{{ translations.benefits.seamless.description }}</p>
            </div>
          </div>
        </div>
        
        <div class="col-md-6 col-lg-3" data-animate="animate__bounceIn" data-delay="delay-100ms">
          <div class="card h-100 border-0 shadow-sm" style="background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border) !important; border-radius: var(--radius-lg); transition: all var(--transition-base);" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 8px 20px rgba(0,0,0,0.4)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 8px rgba(0,0,0,0.2)'">
            <div class="card-body text-center p-4">
              <div style="color: var(--color-accent-purple); margin-bottom: var(--space-lg);">
                <i class="bi bi-shield-lock-fill fs-1"></i>
              </div>
              <h3 class="h4 mb-3" style="color: var(--color-text-primary); font-weight: 600;">{{ translations.benefits.secure.title }}</h3>
              <p class="card-text" style="color: var(--color-text-secondary);">{{ translations.benefits.secure.description }}</p>
            </div>
          </div>
        </div>
        
        <div class="col-md-6 col-lg-3" data-animate="animate__bounceIn" data-delay="delay-200ms">
          <div class="card h-100 border-0 shadow-sm" style="background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border) !important; border-radius: var(--radius-lg); transition: all var(--transition-base);" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 8px 20px rgba(0,0,0,0.4)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 8px rgba(0,0,0,0.2)'">
            <div class="card-body text-center p-4">
              <div style="color: var(--color-accent-purple); margin-bottom: var(--space-lg);">
                <i class="bi bi-lightning-charge-fill fs-1"></i>
              </div>
              <h3 class="h4 mb-3" style="color: var(--color-text-primary); font-weight: 600;">{{ translations.benefits.fast.title }}</h3>
              <p class="card-text" style="color: var(--color-text-secondary);">{{ translations.benefits.fast.description }}</p>
            </div>
          </div>
        </div>
        
        <div class="col-md-6 col-lg-3" data-animate="animate__bounceIn" data-delay="delay-300ms">
          <div class="card h-100 border-0 shadow-sm" style="background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border) !important; border-radius: var(--radius-lg); transition: all var(--transition-base);" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 8px 20px rgba(0,0,0,0.4)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 8px rgba(0,0,0,0.2)'">
            <div class="card-body text-center p-4">
              <div style="color: var(--color-accent-purple); margin-bottom: var(--space-lg);">
                <i class="bi bi-stars fs-1"></i>
              </div>
              <h3 class="h4 mb-3" style="color: var(--color-text-primary); font-weight: 600;">{{ translations.benefits.quality.title }}</h3>
              <p class="card-text" style="color: var(--color-text-secondary);">{{ translations.benefits.quality.description }}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Dynamic Pricing Section -->
  <section id="pricing" class="py-5 py-lg-6 " style="background-color: var(--color-bg-primary);">
    <div class="">
      <div class="row justify-content-center">
        <div class="col-lg-8 text-center">
          <h2 class="display-5 fw-bold mb-4" style="color: var(--color-text-primary);">{{ translations.dynamicPricing.heading }}</h2>
          <p class="lead mb-4" style="color: var(--color-text-secondary);">{{ translations.dynamicPricing.description }}</p>
          <p class="mb-5" style="color: var(--color-text-secondary);">{{ translations.dynamicPricing.reassurance }}</p>
          
          <a href="#top" class="btn btn-lg rounded-pill px-4 py-2 cta" style="background: var(--color-success); color: var(--color-text-primary); border: none; font-weight: 500; transition: all var(--transition-base);" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 0 20px rgba(16, 185, 129, 0.3)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'">
            <i class="bi bi-credit-card me-2"></i>
            {{ translations.dynamicPricing.ctaButton }}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section id="faq" class="py-5 py-lg-6" style="background-color: var(--color-bg-primary);">
    <div class="">
      <h2 class="display-5 fw-bold text-center mb-5" style="color: var(--color-text-primary);">{{ translations.faq.heading }}</h2>
      
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="accordion" id="faqAccordion">
            <div class="accordion-item border mb-3 rounded shadow-sm" data-animate="animate__fadeIn" style="background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border) !important; border-radius: var(--radius-lg) !important;">
              <h3 class="accordion-header" id="headingOne">
                <button class="accordion-button fw-medium" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne" style="background-color: var(--color-bg-tertiary); color: var(--color-text-primary);">
                  {{ translations.faq.q1.question }}
                </button>
              </h3>
              <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#faqAccordion">
                <div class="accordion-body" style="color: var(--color-text-secondary);">
                  {{ translations.faq.q1.answer }}
                </div>
              </div>
            </div>
            
            <div class="accordion-item border mb-3 rounded shadow-sm" data-animate="animate__fadeIn" data-delay="delay-100ms" style="background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border) !important; border-radius: var(--radius-lg) !important;">
              <h3 class="accordion-header" id="headingTwo">
                <button class="accordion-button collapsed fw-medium" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo" style="background-color: var(--color-bg-tertiary); color: var(--color-text-primary);">
                  {{ translations.faq.q2.question }}
                </button>
              </h3>
              <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#faqAccordion">
                <div class="accordion-body" style="color: var(--color-text-secondary);">
                  {{ translations.faq.q2.answer }}
                </div>
              </div>
            </div>
            
            <div class="accordion-item border mb-3 rounded shadow-sm" data-animate="animate__fadeIn" data-delay="delay-200ms" style="background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border) !important; border-radius: var(--radius-lg) !important;">
              <h3 class="accordion-header" id="headingThree">
                <button class="accordion-button collapsed fw-medium" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree" style="background-color: var(--color-bg-tertiary); color: var(--color-text-primary);">
                  {{ translations.faq.q3.question }}
                </button>
              </h3>
              <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#faqAccordion">
                <div class="accordion-body" style="color: var(--color-text-secondary);">
                  {{ translations.faq.q3.answer }}
                </div>
              </div>
            </div>
            
            <div class="accordion-item border mb-3 rounded shadow-sm" data-animate="animate__fadeIn" data-delay="delay-300ms" style="background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border) !important; border-radius: var(--radius-lg) !important;">
              <h3 class="accordion-header" id="headingFour">
                <button class="accordion-button collapsed fw-medium" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour" style="background-color: var(--color-bg-tertiary); color: var(--color-text-primary);">
                  {{ translations.faq.q4.question }}
                </button>
              </h3>
              <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#faqAccordion">
                <div class="accordion-body" style="color: var(--color-text-secondary);">
                  {{ translations.faq.q4.answer }}
                </div>
              </div>
            </div>
            
            <div class="accordion-item border mb-3 rounded shadow-sm" data-animate="animate__fadeIn" data-delay="delay-400ms" style="background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border) !important; border-radius: var(--radius-lg) !important;">
              <h3 class="accordion-header" id="headingFive">
                <button class="accordion-button collapsed fw-medium" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFive" aria-expanded="false" aria-controls="collapseFive" style="background-color: var(--color-bg-tertiary); color: var(--color-text-primary);">
                  {{ translations.faq.q5.question }}
                </button>
              </h3>
              <div id="collapseFive" class="accordion-collapse collapse" aria-labelledby="headingFive" data-bs-parent="#faqAccordion">
                <div class="accordion-body" style="color: var(--color-text-secondary);">
                  {{ translations.faq.q5.answer }}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- CTA Footer Section -->
  <section id="footer-cta" class="py-5 py-lg-6" style="background: linear-gradient(135deg, var(--color-accent-purple), var(--color-accent-pink)); border-radius: var(--radius-lg); margin: var(--space-3xl) 0;">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div style="background-color: var(--color-bg-tertiary); color: var(--color-text-primary); padding: var(--space-3xl); border-radius: var(--radius-lg); box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
            <h2 class="display-5 fw-bold text-center mb-3" data-animate="animate__fadeInDown" style="color: var(--color-text-primary);">{{ translations.footer.ctaHeading }}</h2>
            <p class="lead text-center mb-4" data-animate="animate__fadeInDown" data-delay="delay-100ms" style="color: var(--color-text-secondary);">{{ translations.footer.ctaMessage }}</p>
            <div class="text-center">
              <a href="#top" class="btn btn-lg rounded-pill px-4 py-2 cta" data-animate="animate__zoomIn" data-delay="delay-200ms" style="background: var(--color-accent-gradient); color: var(--color-text-primary); border: none; font-weight: 500; transition: all var(--transition-base);" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 0 20px rgba(168, 85, 247, 0.3)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'">
                <i class="bi bi-check-circle-fill me-2"></i>
                {{ translations.footer.ctaButton }}
              </a>
            </div>
          </div>
        </div>
      </div>
  </section>
</div>