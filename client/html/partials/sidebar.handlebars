<!-- Desktop Sidebar -->
<aside id="app-sidebar" 
       class="sidebar-desktop d-none d-md-block" 
       role="navigation" 
       aria-label="Main navigation">
        <!-- Sidebar Header with Logo and Toggle -->
        <div class="sidebar-header">
            <div class="sidebar-logo" title="TwiixAI Logo">AI</div>
            <h1 class="sidebar-title mb-0">TwiixAI</h1>
            <button id="sidebar-toggle" 
                    class="sidebar-toggle-btn" 
                    aria-label="Toggle sidebar"
                    aria-expanded="true">
                <i class="bi bi-chevron-left"></i>
            </button>
        </div>

        <!-- Main Navigation -->
        <nav class="sidebar-nav" role="navigation" aria-label="Sidebar navigation">
            <ul>
                <!-- Home -->
                <li>
                    <a href="/" aria-label="Home">
                        <span class="icon"><i class="bi bi-house-door"></i></span>
                        <span class="text">Home</span>
                    </a>
                </li>

                <!-- Video AI Section -->
                <li><span class="nav-section-title">Video AI</span></li>
                <li>
                    <a href="/image-to-video" 
                       class="{{#if isImageToVideoPage}}active{{/if}}"
                       aria-label="Image to Video - Generate videos from static images">
                        <span class="icon"><i class="bi bi-image-alt"></i></span>
                        <span class="text">{{t "image_to_video" "Image to Video"}}</span>
                    </a>
                </li>
                <li>
                    <a href="/text-to-video" 
                       class="{{#if isTextToVideoPage}}active{{/if}}"
                       aria-label="Text to Video - Generate videos from text descriptions">
                        <span class="icon"><i class="bi bi-file-earmark-text"></i></span>
                        <span class="text">{{t "text_to_video" "Text to Video"}}</span>
                    </a>
                </li>
                <li>
                    <a href="/video-faceswap" 
                       class="{{#if isFaceSwapVideoPage}}active{{/if}}"
                       aria-label="Video Face Swap - Replace faces in videos">
                        <span class="icon"><i class="bi bi-camera-video"></i></span>
                        <span class="text">{{t "video_face_swap" "Video Face Swap"}}</span>
                    </a>
                </li>

                <!-- Image AI Section -->
                <li><span class="nav-section-title">Image AI</span></li>
                <li>
                    <a href="/image-faceswap" 
                       class="{{#if isFaceSwapImagePage}}active{{/if}}"
                       aria-label="Image Face Swap - Replace faces in images">
                        <span class="icon"><i class="bi bi-image"></i></span>
                        <span class="text">{{t "image_face_swap" "Image Face Swap"}}</span>
                    </a>
                </li>

                <!-- Tools Section -->
                <li><span class="nav-section-title">Tools & More</span></li>
                <li>
                    <a href="/{{#ifCond language '==' 'en'}}ai-tools{{else}}{{language}}/ai-tools{{/ifCond}}"
                       aria-label="AI Tools - Browse all available AI tools">
                        <span class="icon"><i class="bi bi-tools"></i></span>
                        <span class="text">AI Tools</span>
                    </a>
                </li>
                <li>
                    <a href="/history" aria-label="My Creations - View your processed creations">
                        <span class="icon"><i class="bi bi-stars"></i></span>
                        <span class="text">My Creations</span>
                    </a>
                </li>
            </ul>
        </nav>
    </aside>

    <!-- Top Navigation Bar -->
    <div id="navbar-wrapper" style="position: fixed; top: 0; left: 0; right: 0; z-index: 900;">
        <nav class="mobile-navbar text-white" style="height: 60px; padding: 0 var(--space-lg); display:none; width: 100%; align-items: center;">
            <!-- Mobile hamburger menu -->
            <button id="mobile-menu-toggle" 
                    class="d-md-none navbar-toggle-btn my-0" 
                    aria-label="Open navigation menu"
                    aria-expanded="false">
                <i class="bi bi-list"></i>
            </button>
            <div class="mobile-logo d-md-none">
                <div class="sidebar-logo" style="width: 32px; height: 32px;">AI</div>
                <h3 class="my-0 text-white">TwiixAI</h3>
            </div>
        </nav>
    </div>
<!-- Mobile sidebar overlay -->
<div id="mobile-sidebar-overlay" 
     class="d-md-none" 
     style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 1001;">
</div>

<!-- Mobile sidebar -->
<aside id="mobile-sidebar" 
       class="d-md-none" 
       role="navigation"
       aria-label="Mobile navigation"
       style="display: none; position: fixed; top: -100%; left: 0; width: 100%; height: 100%; z-index: 1002; overflow-y: auto;">
    <div class="sidebar-header" style="position: fixed; top: 0; left: 0; right: 0; z-index: 1003; width: 100%;">
        <div class="sidebar-logo" title="TwiixAI Logo">AI</div>
        <h1 class="sidebar-title mb-0">TwiixAI</h1>
        <button id="mobile-sidebar-close" 
                class="btn-close btn-close-white"
                aria-label="Close navigation menu">
                <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <nav class="sidebar-nav" role="navigation" aria-label="Mobile sidebar navigation" style="margin-top: 80px;">
        <ul>
            <li><a href="/"><span class="icon"><i class="bi bi-house-door"></i></span><span class="text">Home</span></a></li>
            <li><span class="nav-section-title">Video AI</span></li>
            <li><a href="/image-to-video" class="{{#if isImageToVideoPage}}active{{/if}}"><span class="icon"><i class="bi bi-image-alt"></i></span><span class="text">{{t "image_to_video" "Image to Video"}}</span></a></li>
            <li><a href="/text-to-video" class="{{#if isTextToVideoPage}}active{{/if}}"><span class="icon"><i class="bi bi-file-earmark-text"></i></span><span class="text">{{t "text_to_video" "Text to Video"}}</span></a></li>
            <li><a href="/video-faceswap" class="{{#if isFaceSwapVideoPage}}active{{/if}}"><span class="icon"><i class="bi bi-camera-video"></i></span><span class="text">{{t "video_face_swap" "Video Face Swap"}}</span></a></li>
            <li><span class="nav-section-title">Image AI</span></li>
            <li><a href="/image-faceswap" class="{{#if isFaceSwapImagePage}}active{{/if}}"><span class="icon"><i class="bi bi-image"></i></span><span class="text">{{t "image_face_swap" "Image Face Swap"}}</span></a></li>
            <li><span class="nav-section-title">Tools & More</span></li>
            <li><a href="/{{#ifCond language '==' 'en'}}ai-tools{{else}}{{language}}/ai-tools{{/ifCond}}"><span class="icon"><i class="bi bi-tools"></i></span><span class="text">AI Tools</span></a></li>
            <li><a href="/history"><span class="icon"><i class="bi bi-stars"></i></span><span class="text">My Creations</span></a></li>
        </ul>
    </nav>
</aside>
