<!DOCTYPE html>
<html lang="{{language}}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/img/logo.ico" type="image/x-icon">
    <title>{{ translations.processing_video }}</title>
 
    <link rel="icon" href="favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="/css/normalize.css" />
    <link rel="stylesheet" href="/css/variables.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/bootstrap-icons.css" />
    <script src="/js/jquery-3.6.0.min.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script>const translations = `{{{json translations}}}`;</script> 
    <script src="/success.js" defer></script>
    <style>
      .progress-status {
        margin-top: var(--space-md);
        text-align: center;
        font-size: var(--font-size-sm);
        color: var(--color-text-secondary);
      }
      
      .progress-container {
        margin-top: var(--space-2xl);
        margin-bottom: var(--space-2xl);
      }
      
      .progress {
        background-color: var(--color-bg-tertiary);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        height: 30px;
        overflow: hidden;
      }
      
      .progress-bar {
        background: linear-gradient(135deg, var(--color-accent-purple), var(--color-accent-pink));
        transition: width var(--transition-base);
      }
      
      #video-result {
        margin-top: var(--space-2xl);
        margin-bottom: var(--space-2xl);
      }
      
      #video-result video {
        width: 100%;
        max-width: 800px;
        height: auto;
        border-radius: var(--radius-lg);
        background-color: var(--color-bg-tertiary);
        border: 1px solid var(--color-border);
      }
      
      .action-buttons-container {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
        margin-top: var(--space-2xl);
      }
      
      .action-buttons-container .btn {
        border-radius: var(--radius-md);
        padding: var(--space-md) var(--space-lg);
        font-weight: 500;
        transition: all var(--transition-base);
      }
      
      .action-buttons-container .btn-primary {
        background: var(--color-accent-gradient);
        border: none;
        color: var(--color-text-primary);
      }
      
      .action-buttons-container .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 20px rgba(168, 85, 247, 0.3);
      }
      
      .status.processing {
        padding: var(--space-lg);
        border-radius: var(--radius-md);
        background-color: var(--color-bg-tertiary);
        border-left: 3px solid var(--color-accent-purple);
        color: var(--color-text-primary);
        margin-bottom: var(--space-xl);
      }
      
      .status.hidden {
        display: none;
      }
      
      .error-text {
        padding: var(--space-lg);
        border-radius: var(--radius-md);
        background-color: rgba(239, 68, 68, 0.1);
        border-left: 3px solid var(--color-error);
        color: var(--color-error);
        margin-bottom: var(--space-xl);
      }
    </style>
  </head>

  <body style="display: flex; flex-direction: column; min-height: 100vh; margin: 0;">
    {{> sidebar}}
    <div id="main-content" style="flex: 1 0 auto; display: flex; flex-direction: column; margin-left: 240px;">
      {{> header translations=translations}}
      <div style="width: 100%; height: 60px;"></div>
      <div class="container-fluid mt-3">
        <section class="main-container">
          <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; margin-bottom: var(--space-2xl);">
            <div>
              <h1 id="main-title" style="color: var(--color-text-primary); font-size: var(--font-size-3xl); font-weight: 700; margin-bottom: var(--space-md);">{{ translations.processing_your_video }}</h1>
            </div>
          </div>
          
          <div id="status-message" class="status processing">{{ translations.retrieving_upload }}</div>
          
          <div id="progress-container" class="progress-container">
            <div class="progress">
              <div id="progress-fill" class="progress-bar" role="progressbar" 
                   style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
            <div id="progress-status" class="progress-status">{{ translations.initializing }}</div>
          </div>
          
          <div id="completion-section" class="hidden">            
            <div id="video-result">
              <video id="video-result-element" controls muted autoplay loop>
                <source id="video-source" src="" type="video/mp4">
                Your browser does not support the video tag.
              </video>
            </div>

            <div class="action-buttons-container" id="action-buttons">
              <button id="another-video-button" class="btn btn-primary">
                <i class="bi bi-play-circle me-2"></i>{{ translations.generate_another_video }}
              </button>
              <button id="change-face-button" class="btn btn-primary">
                <i class="bi bi-shuffle me-2"></i>{{ translations.change_the_face }}
              </button>
              <a id="history-button" href="{{#ifCond language '==' 'en'}}/history{{else}}/{{language}}/history{{/ifCond}}" class="btn btn-primary" style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center;">
                <i class="bi bi-clock-history me-2"></i>{{ translations.history_title }}
              </a>
              <a id="download-link" href="#" download="video.mp4" class="btn btn-primary" style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center;">
                <i class="bi bi-download me-2"></i>{{ translations.download_video }}
              </a>
            </div>
          </div>

          <div id="error-message" class="hidden error-text"></div>
          
          <div id="debug-log" class="hidden" style="margin-top: var(--space-2xl); padding: var(--space-lg); background-color: var(--color-bg-tertiary); border-radius: var(--radius-md); border: 1px solid var(--color-border);">
            <h3 style="color: var(--color-text-primary); margin-bottom: var(--space-md);">Debug Log:</h3>
            <pre id="debug-output" style="color: var(--color-text-secondary); overflow-x: auto; background-color: var(--color-bg-secondary); padding: var(--space-md); border-radius: var(--radius-md); font-size: var(--font-size-xs);"></pre>
          </div>
        </section>
        {{> footer translations=translations}}
      </div>
    </div>
  </body>
</html>
